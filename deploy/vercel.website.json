{
  "version": 2,
  "builds": [
    {
      "src": "nuxt.config.ts",
      "use": "@vercel/nuxt"
    }
  ],
  "env": {
    "NUXT_SIGNAL_EXPORT_TOKEN": "your-signal-export-bearer-token",
    "NUXT_PUBLIC_SITE_ID": "your-site-id",
    "PROVIDER": "node_server",
    "PORT": "3000",
    "HOST": "0.0.0.0"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
