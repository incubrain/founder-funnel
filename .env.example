# {CONFIG}: copy contents into a new .env and update with your values

# HOSTING
PROVIDER="node_server" # Default - choose provider https://nuxt.com/deploy
PORT=3000
HOST=0.0.0.0

# CONFIG
NUXT_PUBLIC_DEBUG="false"
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================
# SIGNAL EXPORT (Polaris pull endpoint)
# ============================================
# Everything the site captures — events, form submissions, errors — lands in a
# capped ring buffer that an external consumer pulls with a cursor. There is no
# outbound webhook and no analytics vendor: this is the entire signal surface.
#
# Bearer token for GET /api/_signals/export. Unset = endpoint returns 503.
NUXT_SIGNAL_EXPORT_TOKEN=
# Stable site identifier stamped on every signal row (defaults to request host)
# NUXT_PUBLIC_SITE_ID=

# STUDIO SETUP - https://content.nuxt.com/docs/studio/setup
STUDIO_GITHUB_CLIENT_ID="your_github_client_id"
STUDIO_GITHUB_CLIENT_SECRET="your_github_client_secret"
STUDIO_GITHUB_BRANCH_NAME="develop || staging || main"
