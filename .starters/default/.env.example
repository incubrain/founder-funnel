# =============================================================================
# Foundry Starter — Environment Variables
# Copy this file: cp .env.example .env
# =============================================================================

# Site URL (used for SEO, OG images, sitemaps)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Debug mode (disable in production)
# NUXT_PUBLIC_DEBUG=false

# -----------------------------------------------------------------------------
# Analytics (Umami — privacy-first, self-hosted)
# -----------------------------------------------------------------------------
# NUXT_PUBLIC_SCRIPTS_UMAMI_ANALYTICS_WEBSITE_ID=
# NUXT_PUBLIC_SCRIPTS_UMAMI_ANALYTICS_SCRIPT_INPUT_SRC=

# -----------------------------------------------------------------------------
# Webhooks — where captured signals are sent
# Supports: Telegram, Discord, Slack (comma-separate for multiple)
# -----------------------------------------------------------------------------
# NUXT_WEBHOOK_URL=
# NUXT_TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Signal export — events + error logs pulled by an external consumer (Polaris)
# Required for GET /api/_signals/export; without it the endpoint stays closed.
# -----------------------------------------------------------------------------
# NUXT_SIGNAL_EXPORT_TOKEN=
# NUXT_PUBLIC_SITE_ID=
