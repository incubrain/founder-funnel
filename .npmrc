# temporary fix for import.meta being undefined in postinstall scripts
shamefully-hoist=true

# Resolve workspace packages from local sources by default (pnpm 10+ default is false).
# This makes examples/foundry use the in-repo layer/ instead of the published npm package.
# To test against the published @incubrain/foundry, comment this line out + pnpm install.
link-workspace-packages=true