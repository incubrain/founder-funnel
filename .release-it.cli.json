{
  "git": {
    "requireCleanWorkingDir": true,
    "commitMessage": "chore(release): create-foundry v${version}",
    "tagName": "cli-v${version}",
    "tagAnnotation": "CLI Release v${version}"
  },
  "github": {
    "release": true,
    "releaseName": "create-foundry v${version}",
    "web": true
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/bumper": {
      "in": "./cli/package.json",
      "out": ["./cli/package.json"]
    }
  },
  "hooks": {
    "before:init": ["pnpm cli:build"]
  }
}
