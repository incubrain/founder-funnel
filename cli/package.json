{
  "name": "create-foundry",
  "version": "0.7.0",
  "description": "Create a new IncuBrain Foundry project",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-foundry": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "files": [
